{
  "store.custom#faq": {
    "children": [
      "flex-layout.row#faq"
    ]
  },
  "flex-layout.row#faq": {
    "props": {
      "blockClass": "faq"
    },
    "children": [
      "flex-layout.col#faq"
    ]
  },
  "flex-layout.col#faq": {
    "children": [
      "rich-text#faq",
      "rich-text#etapas",
      "disclosure-layout-group#group"
    ]
  },
  "rich-text#faq": {
    "props": {
      "text": "## FAQ",
         "blockClass": "title-faq"
    }
  },
  "rich-text#etapas": {
    "props": {
      "text": "## ETAPAS PARA SE CADASTAR",
         "blockClass": "subtitle-faq"

    }
  },
  "disclosure-layout-group#group": {
    "children": [
      "disclosure-layout#first",
      "disclosure-layout#second",
      "disclosure-layout#third",
      "disclosure-layout#fourth",
      "disclosure-layout#five",
      "disclosure-layout#six",
      "disclosure-layout#serven"
    ]
  },
  "disclosure-layout#first": {
    "props": {
      "animated": true
    },
    "children": [
      "disclosure-trigger#first",
      "disclosure-content#first"
    ]
  },
  "disclosure-trigger#first": {
    "props": {
      "blockClass": "question",
      "as": "div"
    },
    "children": [
      "disclosure-state-indicator",
      "rich-text#question1"
    ]
  },
  "disclosure-content#first": {
    "props": {
      "blockClass": "answer"
    },
    "children": [
      "rich-text#answer1",
      "image#faq-1"
    ]
  },
  "rich-text#question1": {
    "props": {
      "text": "Passo 1 - clique no ícone “MINHA CONTA”"
    }
  },
  "rich-text#answer1": {
    "props": {
      "text": "Clique no ícone indicado na imagem, ao lado da lupa e sacola de compra. Este é o ícone de usuário, através dele você pode se conectar com sua conta Consciência Jeans,monitorar seus pedidos, alterar seus dados, etc."
    }
  },

  "image#faq-1": {
    "props": {
      "src": "assets/imgs/pinterest.png",
      "maxHeight": "",
      "maxWidth": "",
      "blockClass": ["storePrint", "img-rede-social"]
    }
  },
  "disclosure-layout#second": {
    "props": {
      "animated": true
    },
    "children": [
      "disclosure-trigger#second",
      "disclosure-content#second"
    ]
  },
  "disclosure-trigger#second": {
    "props": {
      "blockClass": "question",
      "as": "div"
    },
    "children": [
      "disclosure-state-indicator",
      "rich-text#question2"
    ]
  },
  "disclosure-content#second": {
    "props": {
      "blockClass": "answer"
    },
    "children": [
      "rich-text#answer2"
    ]
  },
  "rich-text#question2": {
    "props": {
      "text": "Passo 2 - clique no botão “LOGIN”"
    }
  },
  "rich-text#answer2": {
    "props": {
      "text": "Clique em LOGIN e será redirecionado para a página onde poderá fazer seu cadastro."
    }
  },
  "disclosure-layout#third": {
    "props": {
      "animated": true
    },
    "children": [
      "disclosure-trigger#third",
      "disclosure-content#third"
    ]
  },
  "disclosure-trigger#third": {
    "props": {
      "blockClass": "question",
      "as": "div"
    },
    "children": [
      "disclosure-state-indicator",
      "rich-text#question3"
    ]
  },
  "disclosure-content#third": {
    "props": {
      "blockClass": "answer"
    },
    "children": [
      "rich-text#answer3"
    ]
  },
  "rich-text#question3": {
    "props": {
      "text": "Passo 3 - ou clique em “CADASTRE-SE”"
    }
  },
  "rich-text#answer3": {
    "props": {
      "text": "Ou desça a página até encontrar a seguinte imagem: Aqui basta clicar em “CADASTRE-SE”"
    }
  },
  "disclosure-layout#fourth": {
    "props": {
      "animated": true
    },
    "children": [
      "disclosure-trigger#fourth",
      "disclosure-content#fourth"
    ]
  },
  "disclosure-trigger#fourth": {
    "props": {
      "blockClass": "question",
      "as": "div"
    },
    "children": [
      "disclosure-state-indicator",
      "rich-text#question4"
    ]
  },
  "disclosure-content#fourth": {
    "props": {
      "blockClass": "answer"
    },
    "children": [
      "rich-text#answer4"
    ]
  },
  "rich-text#question4": {
    "props": {
      "text": "Passo 4 - digite o seu CNPJ"
    }
  },
  "rich-text#answer4": {
    "props": {
      "text": "No campo “NÃO TEM CADASTRO?”, digite seu CNPJ e confirme na seta ao lado."
    }
  },
  "disclosure-layout#five": {
    "props": {
      "animated": true
    },
    "children": [
      "disclosure-trigger#five",
      "disclosure-content#five"
    ]
  },
  "disclosure-trigger#five": {
    "props": {
      "blockClass": "question",
      "as": "div"
    },
    "children": [
      "disclosure-state-indicator",
      "rich-text#question5"
    ]
  },
  "disclosure-content#five": {
    "props": {
      "blockClass": "answer"
    },
    "children": [
      "rich-text#answer5"
    ]
  },
  "rich-text#question5": {
    "props": {
      "text": "Passo 5 - informe o seu Email"
    }
  },
  "rich-text#answer5": {
    "props": {
      "text": "Informe seu e-mail no campo indicado e clique em “ENVIAR”."
    }
  },
  "disclosure-layout#six": {
    "props": {
      "animated": true
    },
    "children": [
      "disclosure-trigger#six",
      "disclosure-content#six"
    ]
  },
  "disclosure-trigger#six": {
    "props": {
      "blockClass": "question",
      "as": "div"
    },
    "children": [
      "disclosure-state-indicator",
      "rich-text#question6"
    ]
  },
  "disclosure-content#six": {
    "props": {
      "blockClass": "answer"
    },
    "children": [
      "rich-text#answer6"
    ]
  },
  "rich-text#question6": {
    "props": {
      "text": "Passo 6 - digite a sua chave de acesso"
    }
  },
  "rich-text#answer6": {
    "props": {
      "text": "No campo “Chave de Acesso” digite o código de verificação enviado no e-mail escolhido. Digite uma senha, digite-a novamente para confirmar e não esqueça de conferir os requisitos (Mínimo de 8 caracteres, 1 número, 1 letra minúscula e 1 letra maiúscula). Clique em “OK”."
    }
  },
  "disclosure-layout#serven": {
    "props": {
      "animated": true
    },
    "children": [
      "disclosure-trigger#serven",
      "disclosure-content#serven"
    ]
  },
  "disclosure-trigger#serven": {
    "props": {
      "blockClass": "question",
      "as": "div"
    },
    "children": [
      "disclosure-state-indicator",
      "rich-text#question7"
    ]
  },
  "disclosure-content#serven": {
    "props": {
      "blockClass": "answer"
    },
    "children": [
      "rich-text#answer7"
    ]
  },
  "rich-text#question7": {
    "props": {
      "text": "Passo 7 - preencha as informações e confirme os seus dados de cadastro"
    }
  },
  "rich-text#answer7": {
    "props": {
      "text": "Confirme as informações e preencha as que forem solicitadas através das 4 etapas, por fim conclua o cadastro e pronto, sua conta estará criada"
    }
  },
  "disclosure-state-indicator": {
    "props": {
      "Show": "icon-caret#down",
      "Hide": "icon-caret#up"
    }
  },
  "icon-caret#down": {
    "props": {
      "orientation": "down"
    }
  },
  "icon-caret#up": {
    "props": {
      "orientation": "up"
    }
  }
}